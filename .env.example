# ==============================================================================
# KARATE AI QA ORCHESTRATOR - CONFIGURATION
# ==============================================================================

# Port for the Local Karate Runner Service (Bridge between n8n and Maven)
PORT=5050

# Absolute path to your Karate Maven test directory
# Default points to beyond-lo-tests in your workspace
KARATE_PROJECT_PATH=C:/Latest-BeyondLo-Sep23rd/beyond-lo/beyond-lo-tests

# Default Karate environment (dev: 9090, test/staging: 9190)
DEFAULT_KARATE_ENV=test

# AI Model Provider for Triage (gemini, openai, or heuristic)
AI_PROVIDER=gemini

# API Key for the AI Provider (Optional: Heuristic fallback works offline!)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Slack / Teams Webhook URL for Notifications & Alerts (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ------------------------------------------------------------------------------
# MantisBT Bug Tracker REST API Integration
# ------------------------------------------------------------------------------
# Your IRD Mantis URL: https://mantis.irdsoft.com/api/rest
MANTIS_BASE_URL=https://mantis.irdsoft.com/api/rest
MANTIS_API_TOKEN=your_mantis_api_token_here
MANTIS_PROJECT_NAME=LOS system
MANTIS_CATEGORY=Issue
MANTIS_REPORTER_EMAIL=naga.reddy@irdsoft.com

